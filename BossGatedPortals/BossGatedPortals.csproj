<?xml version="1.0" encoding="utf-8"?>
<!-- Based on JotunnModStub (MIT No Attribution). Unity and Thunderstore steps removed. -->
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local paths (VALHEIM_INSTALL, BEPINEX_PATH, MOD_DEPLOYPATH) live in Environment.props, not in git. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Environment.props" Condition="Exists('$(MSBuildThisFileDirectory)..\Environment.props')" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>BossGatedPortals</RootNamespace>
    <AssemblyName>BossGatedPortals</AssemblyName>
    <Deterministic>true</Deterministic>
    <LangVersion>10</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Let Jotunn generate "publicized" copies of Valheim's DLLs (re-runs after game updates). -->
    <ExecutePrebuild>true</ExecutePrebuild>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JotunnLib" Version="2.30.2" />
  </ItemGroup>

  <!-- Copy the built DLL into the Gale profile so the game loads it. -->
  <Target Name="DeployToGale" AfterTargets="Build" Condition=" '$(MOD_DEPLOYPATH)' != '' ">
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(MOD_DEPLOYPATH)\BossGatedPortals" />
    <Message Text="Copied $(TargetFileName) to $(MOD_DEPLOYPATH)\BossGatedPortals" Importance="high" />
  </Target>
</Project>
